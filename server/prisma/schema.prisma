generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                Int        @id @default(autoincrement())
  barcode           String     @unique
  sku               String     @unique
  name              String
  description       String?
  costPriceCents    Int
  sellingPriceCents Int
  stockQuantity     Int        @default(0)
  reorderLevel      Int        @default(5)
  unit              String     @default("ITEM")
  isActive          Boolean    @default(true)
  categoryId        Int
  category          Category   @relation(fields: [categoryId], references: [id])
  saleItems         SaleItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("CASHIER")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  sales        Sale[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
}

model Sale {
  id              Int        @id @default(autoincrement())
  receiptNumber   String     @unique
  subtotalCents   Int
  discountCents   Int        @default(0)
  totalCents      Int
  paymentMethod   String
  amountPaidCents Int
  changeCents     Int
  status          String     @default("COMPLETED")
  cashierId       Int
  cashier         User       @relation(fields: [cashierId], references: [id])
  items           SaleItem[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([cashierId])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id             Int      @id @default(autoincrement())
  saleId         Int
  sale           Sale     @relation(fields: [saleId], references: [id])
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  barcode        String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  createdAt      DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}
