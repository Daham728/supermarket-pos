{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
 "include": [
  "src/**/*.ts",
  "prisma/**/*.ts",
  "scripts/**/*.ts",
  "prisma.config.ts"
],
  "exclude": [
    "node_modules",
    "dist"
  ]

  
}